---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import siteJs from '../scripts/site.js?raw';
import { SITE, abs, ogPathFor } from '../lib/site';
import { organization, website } from '../lib/schema';

interface Props {
  title: string; // full <title>
  description: string;
  path: string; // canonical path, always with trailing slash
  ogTitle?: string;
  ogImage?: string; // site path; defaults to the generated per-page image
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  jsonLd?: object[];
  noindex?: boolean;
  published?: Date;
  modified?: Date;
}

const { title, description, path, ogTitle = title, ogType = 'website', jsonLd = [], noindex = false, published, modified } = Astro.props;
const ogImage = abs(Astro.props.ogImage ?? ogPathFor(path));
const ogImageAlt = Astro.props.ogImageAlt ?? `${ogTitle} | statement.work`;
const canonical = abs(path);
const graph = { '@context': 'https://schema.org', '@graph': [organization, website, ...jsonLd] };
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
{!noindex && <link rel="canonical" href={canonical}>}
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'}>
<meta name="theme-color" content="#F6F7F4">
<meta name="color-scheme" content="light">

<meta property="og:type" content={ogType}>
<meta property="og:site_name" content={SITE.name}>
<meta property="og:url" content={canonical}>
<meta property="og:title" content={ogTitle}>
<meta property="og:description" content={description}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={ogImageAlt}>
<meta property="og:locale" content="en_US">
{published && <meta property="article:published_time" content={published.toISOString()}>}
{modified && <meta property="article:modified_time" content={modified.toISOString()}>}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={ogTitle}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImage}>
<meta name="twitter:image:alt" content={ogImageAlt}>

<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180">
<link rel="manifest" href="/site.webmanifest">
<link rel="alternate" type="application/rss+xml" title="statement.work guides" href="/rss.xml">
<link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-friendly summary">
<link rel="sitemap" type="application/xml" href="/sitemap.xml">
<link rel="preload" href="/fonts/schibsted-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin>

<script type="application/ld+json" set:html={JSON.stringify(graph)} />
<script is:inline>document.documentElement.classList.add('js');</script>
<slot name="head" />
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<Header path={path} />
<main id="main">
  <slot />
</main>
<Footer />
<script is:inline set:html={siteJs} />
<slot name="scripts" />
</body>
</html>
