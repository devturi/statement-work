---
import { getCollection, render } from 'astro:content';
import PageShell from '../../layouts/PageShell.astro';
import { landingPath } from '../../lib/pages';

export async function getStaticPaths() {
  const entries = await getCollection('convert');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const path = landingPath.convert(entry.id);
---
<PageShell
  metaTitle={d.metaTitle}
  description={d.description}
  path={path}
  title={d.title}
  lede={d.lede}
  updated={d.updated}
  crumbs={[{ name: 'Home', path: '/' }, { name: 'Convert', path: '/convert/' }, { name: d.nav ?? d.title, path }]}
  faqs={d.faqs}
  related={d.related}
  software={true}
>
  <Content />
</PageShell>
