---
import { getPage } from '../lib/pages';
interface Props { paths: string[]; heading?: string }
const { paths, heading = 'Related pages' } = Astro.props;
const pages = await Promise.all(paths.map(getPage)); // throws at build time on a broken link
---
<section class="related" aria-labelledby="related-title">
  <h2 id="related-title">{heading}</h2>
  <ul class="link-rows">
    {pages.map((p) => (
      <li>
        <a href={p.path}>
          <span class="lr-kicker">{p.section}</span>
          <span class="lr-title">{p.title}</span>
          <span class="lr-desc">{p.description}</span>
        </a>
      </li>
    ))}
  </ul>
</section>
